<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
</head>
<body>
    <h2>Edit your post</h2>
    <P>Post id: <%=post.id%></P>
    <p>Post username:<%=post.username%></p>
    <br>
    <!-- in html post we can only send get or post request . it is not possible directly but we caan use a package in doing that that package is called method override -->
<!-- this line in the action override the post method into patch method with the help of an npm package -->
    <form method="post" action="/posts/<%=post.id%>?_method=PATCH">
        <textarea rows="10" cols="35" name="content"><%=post.content%></textarea>
        <br>
        <button>Submit</button>
    </form>
    
</body>
</html>